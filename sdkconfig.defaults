# PSRAM: only enable for ESP32-S3-WROOM-1-N16R8 (8MB Octal PSRAM).
# This board uses N16 without PSRAM; keep SPIRAM disabled.
CONFIG_GPS_ENABLE=y
CONFIG_GPS_UART_TX_PIN=43
CONFIG_GPS_UART_RX_PIN=44
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_WIFI_SSID="清和科技"
CONFIG_WIFI_PASSWORD="qinghekeji"
CONFIG_KEY_NEW1_PIN=46
CONFIG_KEY_NEW2_PIN=47
CONFIG_PA_CTRL_GPIO=21

# ESP-SR is optional. Enable CONFIG_APP_SR_ENABLE only when the esp-sr component is installed.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wake word setting for optional ESP-SR.
# CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y

# Chinese command recognition (MultiNet6)
# CONFIG_SR_MN_CN_NONE=n
# CONFIG_SR_MN_CN_MULTINET6_QUANT=y

# CONFIG_APP_SR_ENABLE is not set
